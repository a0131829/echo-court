; Echo Court — an original one-room spatial puzzle.
config_version=5

[application]
config/name="回聲庭院 · Echo Court"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="Three pastel island puzzles. Turn bridges, climb towers, and bring the lights home."
config/version="0.5.0"

[display]
window/size/viewport_width=900
window/size/viewport_height=1200
window/size/window_width_override=675
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/min_width=450
window/size/min_height=600

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.105, 0.225, 0.24, 1)

[audio]
default_bus_layout="res://default_bus_layout.tres"
